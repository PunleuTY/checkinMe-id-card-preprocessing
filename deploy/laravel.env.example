# Gemini OCR service — Cloud Run values for your Laravel .env
# Copy these into gemini-laravel-test/.env (or your real Laravel app's .env),
# replacing BASE_URL with the URL that deploy.sh prints.

# The Cloud Run service URL — HTTPS, no port (Cloud Run terminates TLS on 443).
GEMINI_SERVICE_BASE_URL=https://gemini-ocr-xxxxxxxxxx-as.a.run.app

# Raised from 30 → 60 to absorb a cold start (~5s) plus a slow Gemini call.
# If you deploy with MIN_INSTANCES=1 (no scale-to-zero), 30 is fine again.
GEMINI_SERVICE_TIMEOUT=60

GEMINI_SERVICE_MODEL=gemini-2.5-flash
GEMINI_SERVICE_ENDPOINTS_SCAN_NID=/gemini-ocr/upload

# NOTE: GeminiService::scanNid() only calls the real service when
# app()->environment() == 'production'. In local/dev it returns mock fields.
# To exercise the live Cloud Run service from your machine, set APP_ENV=production
# (or temporarily bypass that guard) in the Laravel app while testing.
